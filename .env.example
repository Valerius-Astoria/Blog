# Example env vars for Render / production (copy values from Neon console)
SPRING_DATASOURCE_URL=jdbc:postgresql://ep-XXXX.region.aws.neon.tech/neondb?sslmode=require
SPRING_DATASOURCE_USERNAME=neondb_owner
SPRING_DATASOURCE_PASSWORD=your-neon-password
REMEMBER_ME_KEY=change-me

# Register these callback URLs with the providers:
# https://your-domain/login/oauth2/code/google
# https://your-domain/login/oauth2/code/github
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
